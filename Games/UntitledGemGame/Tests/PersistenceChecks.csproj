<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="SpatialBaseline/**" />
    <Compile Remove="PlatformChecks/**" />
    <ProjectReference Include="SpatialBaseline/SpatialBaseline.csproj" Aliases="SpatialBaseline" />
    <!-- Test the built game without starting its graphics/content pipeline. -->
    <Reference Include="../bin/$(Configuration)/net10.0/*.dll" />
  </ItemGroup>
</Project>
