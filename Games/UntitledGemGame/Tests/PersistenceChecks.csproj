<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../Content/Menu/*.png" Link="Content/Menu/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="SpatialBaseline/**" />
    <Compile Remove="PlatformChecks/**" />
    <Compile Remove="PreloadChecks/**" />
    <ProjectReference Include="SpatialBaseline/SpatialBaseline.csproj" Aliases="SpatialBaseline" />
    <!-- Test the built game without starting its graphics/content pipeline. -->
    <Reference Include="../bin/$(Configuration)/net10.0/*.dll" />
    <!-- Native libraries the game's packages load (FreeType for Gum's menu fonts). -->
    <None Include="../bin/$(Configuration)/net10.0/runtimes/$(NETCoreSdkRuntimeIdentifier)/native/*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
