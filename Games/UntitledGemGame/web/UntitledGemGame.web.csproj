<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace>UntitledGemGame.web</RootNamespace>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SkipAposShapeContent>true</SkipAposShapeContent>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);KNI;BLAZORGL;KNI_WEB</DefineConstants>
    <KniPlatform>BlazorGL</KniPlatform>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../*.cs;../Entities/**/*.cs;../Screens/**/*.cs;../Systems/**/*.cs;../Platform/**/*.cs;../Pages/**/*.cs" />
    <Compile Include="../../Generation/JsonObjects.cs" />
    <AdditionalFiles Include="../Content/Data/upgrades.json;../Content/Data/upgrades_abilities.json;../Content/Data/upgrades_meta.json" />
    <Content Include="../*.razor;../*.razor.css">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="../Pages/**/*.razor">
      <Link>Pages/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <BrowserAsset Include="../wwwroot/**/*">
      <TargetPath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </BrowserAsset>
    <!-- Reuse the existing KNI XNB assets for the initial browser bring-up.
         The old Content.mgcb includes obsolete generated desktop output. -->
    <BrowserAsset Include="../Content/GumProject/**/*"
             Exclude="../Content/GumProject/**/bin/**;../Content/GumProject/**/obj/**">
      <TargetPath>wwwroot/Content/GumProject/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </BrowserAsset>
    <BrowserAsset Include="../Content/Textures/Foozle_2DS0013_Void_EnemyFleet_2/Nairan/Designs - Base/PNGs/*.png">
      <TargetPath>wwwroot/Content/Textures/Foozle_2DS0013_Void_EnemyFleet_2/Nairan/Designs - Base/PNGs/%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </BrowserAsset>
    <BrowserAsset Include="../Content/Textures/logo_4k.png">
      <TargetPath>wwwroot/Content/Textures/logo_4k.png</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </BrowserAsset>
    <!-- Gameplay textures added since the precompiled browser content snapshot. -->
    <BrowserAsset Include="../Content/Textures/*_pixel.png">
      <TargetPath>wwwroot/Content/Textures/%(Filename)%(Extension)</TargetPath>
    </BrowserAsset>
    <BrowserAsset Include="../Content/Textures/Foozle_2DS0013_Void_EnemyFleet_2/Nairan/Engine Effects/PNGs/*.png">
      <TargetPath>wwwroot/Content/Textures/Foozle_2DS0013_Void_EnemyFleet_2/Nairan/Engine Effects/PNGs/%(Filename)%(Extension)</TargetPath>
    </BrowserAsset>
    <BrowserAsset Include="../Content/Textures/Gems/Gem5/GEM 5 - LILAC - Spritesheet.png">
      <TargetPath>wwwroot/Content/Textures/Gems/Gem5/%(Filename)%(Extension)</TargetPath>
    </BrowserAsset>
    <BrowserAsset Include="../Content/Data/**/*.json">
      <TargetPath>wwwroot/Content/Data/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </BrowserAsset>
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.17" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.2" />
    <PackageReference Include="Apos.Shapes.KNI" Version="0.6.8" />
    <PackageReference Include="Apos.Tweens" Version="0.2.0" />
    <PackageReference Include="Gum.KNI" Version="2026.5.31.1" />
    <PackageReference Include="KNI.Extended" Version="6.0.0" />

    <PackageReference Include="nkast.Wasm.Audio" Version="8.0.11" />
    <PackageReference Include="nkast.Wasm.Canvas" Version="8.0.11" />
    <PackageReference Include="nkast.Wasm.Dom" Version="8.0.11" />
    <PackageReference Include="nkast.Wasm.JSInterop" Version="8.0.11" />
    <PackageReference Include="nkast.Wasm.XHR" Version="8.0.11" />
    <PackageReference Include="nkast.Wasm.XR" Version="8.0.11" />

    <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Devices" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.XR" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.2.9001.*" />

  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../JapeFramework/JapeFramework.web.csproj" />
    <ProjectReference Include="../../Generation/UpgradesGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="StageBrowserAssets" BeforeTargets="AssignTargetPaths">
    <!-- The dev server resolves static assets under this project's physical
         wwwroot, even when Content items link to files outside the project. -->
    <Copy SourceFiles="@(BrowserAsset)"
          DestinationFiles="@(BrowserAsset->'$(MSBuildProjectDirectory)/%(TargetPath)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot/**/*" />
      <Content Include="@(BrowserAsset->'%(TargetPath)')" />
    </ItemGroup>
  </Target>
</Project>
