<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <PublishAot>true</PublishAot>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <SkipAposShapeContent>true</SkipAposShapeContent>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);KNI_WEB</DefineConstants>
    <KniPlatform>DesktopGL</KniPlatform>
  </PropertyGroup>
  <PropertyGroup>
    <MonoGameExtendedPipelineReferencePath>$(MSBuildThisFileDirectory)pipeline-references</MonoGameExtendedPipelineReferencePath>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="C:\Users\Johan\.nuget\packages\monogame.framework.content.pipeline\3.8.4\contentFiles\any\net8.0\mgfxc.dll" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Generation/JsonObjects.cs" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="./Content/Data/upgrades.json" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Content\bin\**" />
    <None Remove="Content\obj\**" />
    <None Remove=".mgstats" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Content\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.2" />
    <PackageReference Include="Apos.Shapes.KNI" Version="0.6.8" />
    <PackageReference Include="Apos.Tweens" Version="0.2.0" />
    <PackageReference Include="Gum.KNI" Version="2026.5.31.1" />
    <PackageReference Include="KNI.Extended" Version="6.0.0" />
    <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Devices" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.XR" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.2.9001.*" />
    <PackageReference Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="4.2.9001.*" />

  </ItemGroup>
    <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ContentSourceGenerator\ContentSourceGenerator.csproj" />
    <ProjectReference Include="..\..\JapeFramework\JapeFramework.web.csproj" />
    <ProjectReference Include="..\Generation\UpgradesGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Content\Fonts\" />
    <Folder Include="Content\Shaders\GeneratedShaders\" />
    <Folder Include="Content\Textures\" />
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <!--<Exec Command="dotnet ../ContentSourceGenerator/bin/Debug/net8.0/ContentSourceGenerator.dll HelloMonoGame" />-->
    <Exec Command="dotnet $() ../../ContentSourceGenerator/bin/Debug/net10.0/ContentSourceGenerator.dll Games/UntitledGemGame" />
  </Target>
