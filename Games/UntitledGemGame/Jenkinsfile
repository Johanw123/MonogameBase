pipeline {
    agent { label 'windows' }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timestamps()
    }

    parameters {
        // Keep the last selection as the default for webhook and polling builds.
        booleanParam(
            name: 'UPLOAD_TO_STEAM',
            defaultValue: params.containsKey('UPLOAD_TO_STEAM') ? params.UPLOAD_TO_STEAM : true,
            description: 'Upload to the Steam Playtest jenkins branch. Uncheck to pause uploads; the selection is remembered for future builds.'
        )
    }

    environment {
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
        DOTNET_NOLOGO = '1'
        GAME_DIRECTORY = 'Games/UntitledGemGame'
        RUNTIME = 'win-x64'
        STEAMCMD = 'C:\\steamworksSDK\\tools\\ContentBuilder\\builder\\steamcmd.exe'
        STEAM_BUILD_ACCOUNT = 'teamjape_builder'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    extensions: [
                        [$class: 'CleanBeforeCheckout', deleteUntrackedNestedRepositories: true],
                        [$class: 'CloneOption', depth: 1, noTags: true, shallow: true, timeout: 20],
                        [$class: 'CheckoutOption', timeout: 20]
                    ],
                    userRemoteConfigs: [[
                        url: 'https://github.com/Johanw123/MonogameBase.git',
                        refspec: '+refs/heads/main:refs/remotes/origin/main'
                    ]]
                ])
            }
        }

        stage('Verify toolchain') {
            steps {
                bat '''@echo off
where dotnet
dotnet --version || exit /b 1
dotnet --list-sdks || exit /b 1
'''
            }
        }

        stage('Restore') {
            steps {
                dir("${GAME_DIRECTORY}") {
                    bat '''@echo off
dotnet restore ContentBuilder/ContentBuilder.csproj || exit /b 1
dotnet restore UntitledGemGame.csproj || exit /b 1
dotnet restore Tests/PersistenceChecks.csproj || exit /b 1
dotnet restore Tests/PreloadChecks/PreloadChecks.csproj || exit /b 1
dotnet restore Tests/PlatformChecks/PlatformChecks.csproj || exit /b 1
'''
                }
            }
        }

        stage('Build and check') {
            steps {
                dir("${GAME_DIRECTORY}") {
                    bat '''@echo off
dotnet build UntitledGemGame.csproj -c Release --no-restore || exit /b 1
dotnet run --project Tests/PersistenceChecks.csproj -c Release --no-restore || exit /b 1
dotnet run --project Tests/PreloadChecks/PreloadChecks.csproj -c Release --no-restore || exit /b 1
dotnet run --project Tests/PlatformChecks/PlatformChecks.csproj -c Release --no-restore || exit /b 1
'''
                }
            }
        }

        stage('Publish') {
            steps {
                dir("${GAME_DIRECTORY}") {
                    bat '''@echo off
dotnet publish UntitledGemGame.csproj -c Release -r %RUNTIME% --self-contained true -o artifacts/publish/%RUNTIME% -p:Version=0.1.%BUILD_NUMBER% || exit /b 1
if not exist "artifacts\\publish\\%RUNTIME%\\Content\\Textures\\red_pixel.xnb" (echo ERROR: Published Content folder is missing required game assets.& exit /b 1)
'''
                }
            }
        }

        stage('Package') {
            steps {
                dir("${GAME_DIRECTORY}") {
                    bat '''@echo off
powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$ErrorActionPreference = 'Stop'; New-Item -ItemType Directory -Force -Path 'artifacts/packages' | Out-Null" || exit /b 1
tar.exe -a -c -f "artifacts/packages/UntitledGemGame-%RUNTIME%-build-%BUILD_NUMBER%.zip" -C "artifacts/publish/%RUNTIME%" . || exit /b 1
tar.exe -t -f "artifacts/packages/UntitledGemGame-%RUNTIME%-build-%BUILD_NUMBER%.zip" | findstr /e /c:"Content/Textures/red_pixel.xnb" >nul || (echo ERROR: Packaged artifact is missing its Content directory.& exit /b 1)
'''
                }
            }
        }

        stage('Deploy Steam Playtest') {
            when {
                expression { return params.UPLOAD_TO_STEAM }
            }
            steps {
                dir("${GAME_DIRECTORY}") {
                    bat '''@echo off
if not exist "%STEAMCMD%" (echo ERROR: SteamCMD was not found at %STEAMCMD%.& exit /b 1)
if not exist "artifacts\\publish\\%RUNTIME%\\UntitledGemGame.exe" (echo ERROR: Steam upload source is missing UntitledGemGame.exe.& exit /b 1)
"%STEAMCMD%" +login "%STEAM_BUILD_ACCOUNT%" +run_app_build "%CD%\\Steam\\app_build_5426850.vdf" +quit
if errorlevel 1 exit /b %ERRORLEVEL%
'''
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'Games/UntitledGemGame/artifacts/packages/*.zip', fingerprint: true
        }
    }
}
