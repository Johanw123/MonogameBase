    {"at": 6.667, "dur": 3.333, "text": "*130* GEMS", "sub": "+ Genesis Spiral", "fade": 0.06},
    {"at": 10.0, "dur": 3.333, "text": "MIDAS *PULSE*", "sub": "Gems turn gold: double value", "fade": 0.06},
    {"at": 13.333, "dur": 3.334, "text": "FULLY\n*UPGRADED*", "sub": "330 gems, all gold", "fade": 0.06}
